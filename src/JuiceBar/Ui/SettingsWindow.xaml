<Window x:Class="JuiceBar.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:JuiceBar.Ui"
        Title="{ui:Translate settings.title}"
        Width="500" SizeToContent="Height"
        MaxHeight="820"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
            <Setter Property="Margin" Value="2,0,0,7" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24,22,20,0">
            <StackPanel Margin="0,0,4,20">

                <!-- ─── 요금 ─── -->
                <TextBlock Text="{ui:Translate settings.tariff}" Style="{StaticResource SectionTitle}" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="TariffSummaryText"
                                   Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap"
                                   LineHeight="19" />

                        <Button Content="{ui:Translate settings.changeTariff}"
                                Style="{StaticResource AccentButton}"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,0"
                                Click="OnOpenWizard" />
                    </StackPanel>
                </Border>

                <!-- ─── 예산 ─── -->
                <TextBlock Text="{ui:Translate settings.budget}" Style="{StaticResource SectionTitle}" Margin="2,22,0,7" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="BudgetBox"
                                     Style="{StaticResource FieldBox}"
                                     Width="140"
                                     VerticalContentAlignment="Center" />
                            <TextBlock x:Name="BudgetUnit"
                                       Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource LabelText}"
                                   FontWeight="Normal"
                                   TextWrapping="Wrap"
                                   Margin="2,8,0,0"
                                   Text="{ui:Translate settings.budgetHint}" />
                    </StackPanel>
                </Border>

                <!-- ─── 게이지 ─── -->
                <TextBlock Text="{ui:Translate settings.gauge}" Style="{StaticResource SectionTitle}" Margin="2,22,0,7" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <RadioButton x:Name="BudgetModeRadio"
                                     GroupName="GaugeMode"
                                     FontFamily="{StaticResource UiFont}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     Content="{ui:Translate settings.gauge.budget}" />
                        <RadioButton x:Name="InstantModeRadio"
                                     GroupName="GaugeMode"
                                     FontFamily="{StaticResource UiFont}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     Margin="0,9,0,0"
                                     Content="{ui:Translate settings.gauge.instant}" />
                    </StackPanel>
                </Border>

                <!-- ─── 언어 ─── -->
                <TextBlock Text="{ui:Translate settings.language}" Style="{StaticResource SectionTitle}" Margin="2,22,0,7" />

                <Border Style="{StaticResource Card}">
                    <!--
                        DisplayMemberPath 는 직접 만든 템플릿에서 선택 항목에 적용되지 않는다.
                        ItemTemplate 을 명시하면 목록과 선택 표시 양쪽에 모두 쓰인다.
                    -->
                    <ComboBox x:Name="LanguageBox"
                              Style="{StaticResource FieldCombo}"
                              SelectionChanged="OnLanguageChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Border>

                <!-- ─── 시작 ─── -->
                <TextBlock Text="{ui:Translate settings.startup}" Style="{StaticResource SectionTitle}" Margin="2,22,0,7" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="AutoStartCheck"
                                  FontFamily="{StaticResource UiFont}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Content="{ui:Translate settings.autoStart}" />
                        <TextBlock Style="{StaticResource LabelText}"
                                   FontWeight="Normal"
                                   TextWrapping="Wrap"
                                   Margin="24,6,0,0"
                                   Text="{ui:Translate settings.autoStartHint}" />

                        <CheckBox x:Name="AutoUpdateCheck"
                                  FontFamily="{StaticResource UiFont}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Margin="0,14,0,0"
                                  Content="{ui:Translate settings.autoUpdate}" />
                        <TextBlock x:Name="VersionText"
                                   Style="{StaticResource LabelText}"
                                   FontWeight="Normal"
                                   TextWrapping="Wrap"
                                   Margin="24,6,0,0" />
                    </StackPanel>
                </Border>

                <!--
                    ─── 고급 ───
                    평소에는 열어 볼 일이 없다. 센서 구성이 특이한 하드웨어에서
                    합계가 이상할 때만 필요하므로 접어 둔다.
                -->
                <Expander Header="{ui:Translate settings.advanced}"
                          Margin="0,22,0,0"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          FontFamily="{StaticResource UiFont}"
                          FontSize="12">
                    <StackPanel Margin="0,10,0,0">

                        <TextBlock Style="{StaticResource LabelText}"
                                   FontWeight="Normal"
                                   TextWrapping="Wrap"
                                   Margin="2,0,0,8"
                                   Text="{ui:Translate settings.channelsHint}" />

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <ItemsControl x:Name="ChannelList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                          VerticalAlignment="Center" />

                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="{Binding Label}"
                                                               Style="{StaticResource BodyText}" FontSize="12" />
                                                    <TextBlock Text="{Binding HardwareName}"
                                                               Style="{StaticResource LabelText}"
                                                               FontWeight="Normal" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding WattsText}"
                                                           Style="{StaticResource NumericText}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center"
                                                           MinWidth="64" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border BorderBrush="{DynamicResource StrokeBrush}"
                                        BorderThickness="0,1,0,0"
                                        Padding="0,8,0,0"
                                        Margin="0,4,0,0">
                                    <Grid>
                                        <TextBlock Text="{ui:Translate settings.channelTotal}" Style="{StaticResource CaptionText}" />
                                        <TextBlock x:Name="ChannelTotal"
                                                   Style="{StaticResource NumericText}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock x:Name="PawnIoStatus"
                                           Style="{StaticResource LabelText}"
                                           FontWeight="Normal"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,9" />

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{ui:Translate settings.cpuIdle}" Style="{StaticResource CaptionText}"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox x:Name="CpuIdleBox" Style="{StaticResource FieldBox}" Width="70" />

                                    <TextBlock Text="{ui:Translate settings.cpuMax}" Style="{StaticResource CaptionText}"
                                               VerticalAlignment="Center" Margin="16,0,8,0" />
                                    <TextBox x:Name="CpuMaxBox" Style="{StaticResource FieldBox}" Width="70" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="ProfilePathText"
                                   Style="{StaticResource LabelText}"
                                   FontWeight="Normal"
                                   TextWrapping="Wrap"
                                   Margin="2,10,0,0" />
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" Padding="24,14">
            <Grid>
                <TextBlock x:Name="ValidationText"
                           Style="{StaticResource CaptionText}"
                           Foreground="{DynamicResource WarningTextBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Left"
                           MaxWidth="260" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{ui:Translate settings.cancel}" Style="{StaticResource SubtleButton}" Click="OnCancel" />
                    <Button Content="{ui:Translate settings.save}" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Click="OnSave" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
