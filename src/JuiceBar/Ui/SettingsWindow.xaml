<Window x:Class="JuiceBar.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JuiceBar — 설정"
        Width="500" SizeToContent="Height"
        MaxHeight="820"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
            <Setter Property="Margin" Value="2,0,0,7" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24,22,20,0">
            <StackPanel Margin="0,0,4,20">

                <!-- ─── 요금 ─── -->
                <TextBlock Text="전기요금" Style="{StaticResource SectionTitle}" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="TariffSummaryText"
                                   Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap"
                                   LineHeight="19" />

                        <Button Content="전기요금 다시 설정"
                                Style="{StaticResource AccentButton}"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,0"
                                Click="OnOpenWizard" />
                    </StackPanel>
                </Border>

                <!-- ─── 예산 ─── -->
                <TextBlock Text="한 달 예산" Style="{StaticResource SectionTitle}" Margin="2,22,0,7" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="BudgetBox"
                                     Style="{StaticResource FieldBox}"
                                     Width="140"
                                     VerticalContentAlignment="Center" />
                            <TextBlock x:Name="BudgetUnit"
                                       Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource LabelText}"
                                   FontWeight="Normal"
                                   TextWrapping="Wrap"
                                   Margin="2,8,0,0"
                                   Text="연료계가 이 금액을 가득 찬 기준으로 삼습니다. 비워 두면 전력(W) 기준으로 찹니다." />
                    </StackPanel>
                </Border>

                <!-- ─── 게이지 ─── -->
                <TextBlock Text="게이지 기준" Style="{StaticResource SectionTitle}" Margin="2,22,0,7" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <RadioButton x:Name="BudgetModeRadio"
                                     GroupName="GaugeMode"
                                     FontFamily="{StaticResource UiFont}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     Content="예산 대비 — 이번 주기 요금이 예산의 몇 %인지" />
                        <RadioButton x:Name="InstantModeRadio"
                                     GroupName="GaugeMode"
                                     FontFamily="{StaticResource UiFont}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     Margin="0,9,0,0"
                                     Content="순간 전력 — 지금 몇 W를 쓰는지" />
                    </StackPanel>
                </Border>

                <!-- ─── 시작 ─── -->
                <TextBlock Text="시작" Style="{StaticResource SectionTitle}" Margin="2,22,0,7" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="AutoStartCheck"
                                  FontFamily="{StaticResource UiFont}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Content="Windows 로그온 시 자동으로 시작" />
                        <TextBlock Style="{StaticResource LabelText}"
                                   FontWeight="Normal"
                                   TextWrapping="Wrap"
                                   Margin="24,6,0,0"
                                   Text="작업 스케줄러에 등록해 UAC 창 없이 관리자 권한으로 실행합니다." />

                        <CheckBox x:Name="AutoUpdateCheck"
                                  FontFamily="{StaticResource UiFont}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Margin="0,14,0,0"
                                  Content="새 버전 자동으로 확인" />
                        <TextBlock x:Name="VersionText"
                                   Style="{StaticResource LabelText}"
                                   FontWeight="Normal"
                                   TextWrapping="Wrap"
                                   Margin="24,6,0,0" />
                    </StackPanel>
                </Border>

                <!--
                    ─── 고급 ───
                    평소에는 열어 볼 일이 없다. 센서 구성이 특이한 하드웨어에서
                    합계가 이상할 때만 필요하므로 접어 둔다.
                -->
                <Expander Header="고급 — 측정 채널과 CPU 추정"
                          Margin="0,22,0,0"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          FontFamily="{StaticResource UiFont}"
                          FontSize="12">
                    <StackPanel Margin="0,10,0,0">

                        <TextBlock Style="{StaticResource LabelText}"
                                   FontWeight="Normal"
                                   TextWrapping="Wrap"
                                   Margin="2,0,0,8"
                                   Text="합산에 포함할 전력 센서입니다. 하드웨어마다 센서 이름과 의미가 달라 자동 선택이 어긋날 수 있습니다. 합계가 실제 소비보다 크면 중복 합산된 센서가 있다는 뜻입니다." />

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <ItemsControl x:Name="ChannelList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                          VerticalAlignment="Center" />

                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="{Binding Label}"
                                                               Style="{StaticResource BodyText}" FontSize="12" />
                                                    <TextBlock Text="{Binding HardwareName}"
                                                               Style="{StaticResource LabelText}"
                                                               FontWeight="Normal" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding WattsText}"
                                                           Style="{StaticResource NumericText}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center"
                                                           MinWidth="64" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border BorderBrush="{DynamicResource StrokeBrush}"
                                        BorderThickness="0,1,0,0"
                                        Padding="0,8,0,0"
                                        Margin="0,4,0,0">
                                    <Grid>
                                        <TextBlock Text="선택 합계" Style="{StaticResource CaptionText}" />
                                        <TextBlock x:Name="ChannelTotal"
                                                   Style="{StaticResource NumericText}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock x:Name="PawnIoStatus"
                                           Style="{StaticResource LabelText}"
                                           FontWeight="Normal"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,9" />

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="CPU 유휴 W" Style="{StaticResource CaptionText}"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox x:Name="CpuIdleBox" Style="{StaticResource FieldBox}" Width="70" />

                                    <TextBlock Text="최대 W" Style="{StaticResource CaptionText}"
                                               VerticalAlignment="Center" Margin="16,0,8,0" />
                                    <TextBox x:Name="CpuMaxBox" Style="{StaticResource FieldBox}" Width="70" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="ProfilePathText"
                                   Style="{StaticResource LabelText}"
                                   FontWeight="Normal"
                                   TextWrapping="Wrap"
                                   Margin="2,10,0,0" />
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" Padding="24,14">
            <Grid>
                <TextBlock x:Name="ValidationText"
                           Style="{StaticResource CaptionText}"
                           Foreground="{DynamicResource WarningTextBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Left"
                           MaxWidth="260" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="취소" Style="{StaticResource SubtleButton}" Click="OnCancel" />
                    <Button Content="저장" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Click="OnSave" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
