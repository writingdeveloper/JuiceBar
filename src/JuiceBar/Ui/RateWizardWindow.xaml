<Window x:Class="JuiceBar.Ui.RateWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:JuiceBar.Ui"
        Title="{ui:Translate wizard.title}"
        Width="560" Height="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinWidth="520" MinHeight="600"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <Style x:Key="StepNumber" TargetType="Border">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <Style x:Key="StepTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="26,22,22,0">
            <StackPanel Margin="0,0,4,20">

                <TextBlock Text="{ui:Translate wizard.heading}"
                           Style="{StaticResource BodyText}"
                           FontSize="18" FontWeight="SemiBold" />

                <TextBlock Style="{StaticResource CaptionText}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"
                           Text="{ui:Translate wizard.intro}" />

                <!-- ① -->
                <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                    <Border Style="{StaticResource StepNumber}">
                        <TextBlock Text="1" Style="{StaticResource BodyText}"
                                   FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{ui:Translate wizard.step1}" Style="{StaticResource StepTitle}" />
                </StackPanel>

                <Grid Margin="32,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="88" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{ui:Translate wizard.region}"
                               Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />

                    <TextBox x:Name="RegionBox"
                             Grid.Column="1"
                             Style="{StaticResource FieldBox}"
                             VerticalContentAlignment="Center"
                             TextChanged="OnRegionChanged" />

                    <TextBlock Grid.Column="2" Text="{ui:Translate wizard.currency}"
                               Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" Margin="14,0,8,0" />

                    <TextBox x:Name="CurrencyBox"
                             Grid.Column="3"
                             Style="{StaticResource FieldBox}"
                             VerticalContentAlignment="Center"
                             TextChanged="OnRegionChanged" />
                </Grid>

                <Grid Margin="32,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Style="{StaticResource LabelText}"
                               FontWeight="Normal"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               TextWrapping="Wrap"
                               Text="{ui:Translate wizard.regionHint}" />

                    <Button x:Name="CopyButton"
                            Grid.Column="1"
                            Content="{ui:Translate wizard.copy}"
                            Style="{StaticResource AccentButton}"
                            Click="OnCopyPrompt" />
                </Grid>

                <Border Style="{StaticResource Card}" Margin="32,10,0,0">
                    <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="PromptPreview"
                                   Style="{StaticResource CaptionText}"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   FontFamily="Consolas, Courier New"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="32,8,0,0">
                    <TextBlock Text="{ui:Translate wizard.pasteInto}" Style="{StaticResource LabelText}"
                               FontWeight="Normal" VerticalAlignment="Center" />
                    <Button Content="Gemini" Style="{StaticResource SubtleButton}"
                            Tag="https://gemini.google.com/app" Click="OnOpenAi" />
                    <Button Content="ChatGPT" Style="{StaticResource SubtleButton}"
                            Tag="https://chatgpt.com/" Click="OnOpenAi" />
                    <Button Content="Claude" Style="{StaticResource SubtleButton}"
                            Tag="https://claude.ai/new" Click="OnOpenAi" />
                </StackPanel>

                <!-- ② -->
                <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                    <Border Style="{StaticResource StepNumber}">
                        <TextBlock Text="2" Style="{StaticResource BodyText}"
                                   FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{ui:Translate wizard.step2}" Style="{StaticResource StepTitle}" />
                </StackPanel>

                <TextBlock Style="{StaticResource LabelText}"
                           FontWeight="Normal"
                           Margin="34,8,0,0"
                           Text="{ui:Translate wizard.step2Hint}" />

                <TextBox x:Name="ResponseBox"
                         Style="{StaticResource FieldBox}"
                         Margin="32,8,0,0"
                         Height="130"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         TextChanged="OnResponseChanged" />

                <StackPanel Orientation="Horizontal" Margin="32,8,0,0">
                    <Button Content="{ui:Translate wizard.paste}"
                            Style="{StaticResource AccentButton}"
                            Click="OnPasteAndApply" />
                    <Button Content="{ui:Translate wizard.exportCurrent}"
                            Style="{StaticResource SubtleButton}"
                            Margin="6,0,0,0"
                            ToolTip="{ui:Translate wizard.exportCurrentTip}"
                            Click="OnEditCurrentJson" />
                </StackPanel>

                <Border x:Name="ResultCard"
                        Style="{StaticResource Card}"
                        Margin="32,12,0,0"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ResultText"
                               Style="{StaticResource CaptionText}"
                               TextWrapping="Wrap" />
                </Border>

                <!-- ③ -->
                <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                    <Border Style="{StaticResource StepNumber}">
                        <TextBlock Text="3" Style="{StaticResource BodyText}"
                                   FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{ui:Translate wizard.step3}" Style="{StaticResource StepTitle}" />
                </StackPanel>

                <Grid Margin="32,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="BudgetBox" Grid.Column="0" Style="{StaticResource FieldBox}" />

                    <!-- 인식된 통화 기호를 붙여 어떤 단위로 넣어야 할지 알려 준다. -->
                    <TextBlock x:Name="BudgetUnit"
                               Grid.Column="1"
                               Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />

                    <TextBlock Grid.Column="2"
                               Style="{StaticResource LabelText}"
                               FontWeight="Normal"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               TextWrapping="Wrap"
                               Text="{ui:Translate wizard.budgetHint}" />
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" Padding="26,14">
            <Grid>
                <Button Content="{ui:Translate wizard.advanced}"
                        Style="{StaticResource SubtleButton}"
                        HorizontalAlignment="Left"
                        Click="OnOpenAdvanced" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{ui:Translate wizard.later}" Style="{StaticResource SubtleButton}" Click="OnCancel" />
                    <Button x:Name="SaveButton"
                            Content="{ui:Translate wizard.save}"
                            Style="{StaticResource AccentButton}"
                            Margin="8,0,0,0"
                            Click="OnSave" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
