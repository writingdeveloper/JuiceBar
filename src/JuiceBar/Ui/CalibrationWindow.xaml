<Window x:Class="JuiceBar.Ui.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:JuiceBar.Ui"
        Title="{ui:Translate calib.title}"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <StackPanel Margin="24,20,24,22">

        <TextBlock Text="{ui:Translate calib.heading}"
                   Style="{StaticResource BodyText}"
                   FontSize="17" FontWeight="SemiBold" />

        <TextBlock Style="{StaticResource CaptionText}"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   Text="{ui:Translate calib.intro}" />

        <TextBlock Style="{StaticResource CaptionText}"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0"
                   Foreground="{DynamicResource TextTertiaryBrush}"
                   Text="{ui:Translate calib.hint}" />

        <!-- 지금 값 -->
        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{ui:Translate calib.measured}" Style="{StaticResource CaptionText}" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="MeasuredValue"
                           Style="{StaticResource NumericText}" FontWeight="SemiBold" MinWidth="90" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{ui:Translate calib.estimated}"
                           Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="EstimatedValue"
                           Style="{StaticResource NumericText}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,6,0,0" />
            </Grid>
        </Border>

        <!-- 입력 -->
        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="ActualInput"
                     Grid.Column="0"
                     Style="{StaticResource FieldBox}"
                     VerticalContentAlignment="Center"
                     KeyDown="OnInputKeyDown" />

            <Button Grid.Column="1"
                    Content="{ui:Translate calib.add}"
                    Style="{StaticResource AccentButton}"
                    Margin="8,0,0,0"
                    Click="OnAddPoint" />
        </Grid>

        <TextBlock Style="{StaticResource LabelText}"
                   FontWeight="Normal"
                   Margin="2,6,0,0"
                   Text="{ui:Translate calib.inputHint}" />

        <!-- 기록된 지점 -->
        <ItemsControl x:Name="PointList" Margin="0,14,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="•" Style="{StaticResource CaptionText}" Margin="2,0,8,0" />
                        <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource CaptionText}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 결과 -->
        <Border x:Name="ResultCard"
                Style="{StaticResource Card}"
                Margin="0,12,0,0"
                Visibility="Collapsed">
            <TextBlock x:Name="ResultText"
                       Style="{StaticResource CaptionText}"
                       TextWrapping="Wrap" />
        </Border>

        <Grid Margin="0,20,0,0">
            <Button Content="{ui:Translate calib.reset}"
                    Style="{StaticResource SubtleButton}"
                    HorizontalAlignment="Left"
                    Click="OnReset" />
            <Button Content="{ui:Translate calib.close}"
                    Style="{StaticResource AccentButton}"
                    HorizontalAlignment="Right"
                    Click="OnClose" />
        </Grid>
    </StackPanel>
</Window>
