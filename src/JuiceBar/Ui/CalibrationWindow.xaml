<Window x:Class="JuiceBar.Ui.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JuiceBar — 캘리브레이션"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <StackPanel Margin="24,20,24,22">

        <TextBlock Text="전력계 값으로 보정하기"
                   Style="{StaticResource BodyText}"
                   FontSize="17" FontWeight="SemiBold" />

        <TextBlock Style="{StaticResource CaptionText}"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   Text="메인보드·SSD·팬의 전력과 파워서플라이 손실은 센서로 잴 수 없어 추정값을 씁니다. 콘센트에 꽂는 전력계나 전력 측정 기능이 있는 스마트 플러그의 값을 알려 주시면, 이 장비에 맞는 실제 값을 역산합니다." />

        <TextBlock Style="{StaticResource CaptionText}"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0"
                   Foreground="{DynamicResource TextTertiaryBrush}"
                   Text="유휴 상태에서 한 번, 그리고 게임이나 렌더링으로 부하를 준 상태에서 한 번 — 서로 충분히 떨어진 두 지점이 필요합니다." />

        <!-- 지금 값 -->
        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="현재 센서 합산" Style="{StaticResource CaptionText}" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="MeasuredValue"
                           Style="{StaticResource NumericText}" FontWeight="SemiBold" MinWidth="90" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="현재 추정 콘센트 전력"
                           Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="EstimatedValue"
                           Style="{StaticResource NumericText}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,6,0,0" />
            </Grid>
        </Border>

        <!-- 입력 -->
        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="ActualInput"
                     Grid.Column="0"
                     Style="{StaticResource FieldBox}"
                     VerticalContentAlignment="Center"
                     KeyDown="OnInputKeyDown" />

            <Button Grid.Column="1"
                    Content="이 지점 추가"
                    Style="{StaticResource AccentButton}"
                    Margin="8,0,0,0"
                    Click="OnAddPoint" />
        </Grid>

        <TextBlock Style="{StaticResource LabelText}"
                   FontWeight="Normal"
                   Margin="2,6,0,0"
                   Text="전력계에 표시된 값을 와트(W) 단위로 입력하세요." />

        <!-- 기록된 지점 -->
        <ItemsControl x:Name="PointList" Margin="0,14,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="•" Style="{StaticResource CaptionText}" Margin="2,0,8,0" />
                        <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource CaptionText}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 결과 -->
        <Border x:Name="ResultCard"
                Style="{StaticResource Card}"
                Margin="0,12,0,0"
                Visibility="Collapsed">
            <TextBlock x:Name="ResultText"
                       Style="{StaticResource CaptionText}"
                       TextWrapping="Wrap" />
        </Border>

        <Grid Margin="0,20,0,0">
            <Button Content="보정값 초기화"
                    Style="{StaticResource SubtleButton}"
                    HorizontalAlignment="Left"
                    Click="OnReset" />
            <Button Content="닫기"
                    Style="{StaticResource AccentButton}"
                    HorizontalAlignment="Right"
                    Click="OnClose" />
        </Grid>
    </StackPanel>
</Window>
