<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Mica 배경이 비쳐 보이도록 표면은 반투명하게 둔다.
        Mica 를 못 쓰는 환경에서는 아래 SurfaceFallback 이 대신 깔린다.
    -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#CC1B1B1F" />
    <SolidColorBrush x:Key="SurfaceFallbackBrush" Color="#FF1B1B1F" />

    <SolidColorBrush x:Key="CardBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="StrokeBrush" Color="#1AFFFFFF" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F5F7" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A6A6B0" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#70707C" />

    <SolidColorBrush x:Key="AccentBrush" Color="#5AC8F5" />
    <SolidColorBrush x:Key="GaugeTrackBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="NeedleBrush" Color="#F5F5F7" />

    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#2EF5A02C" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#F5B84C" />

</ResourceDictionary>
